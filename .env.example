# ==============================================================================
# TRINITY MARKETS — Environment Variables Configuration Template
# ==============================================================================

# Alpha Vantage API Key (for real-time Equities, REITs, Currencies)
# Free tier: 500 req/day | Get yours at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Google Gemini API Key (for Autonomous Daily Executive 10 Article Generation)
# Get yours at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Refresh cadence in hours (default: 6)
ARTICLE_REFRESH_HOURS=6
